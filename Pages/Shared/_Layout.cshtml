@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - MovieBoxd</title>

    <link rel="stylesheet"
          href="~/css/pixel-theme.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/css/pixel-identity-layout.css"
          asp-append-version="true" />
</head>

<body>

    @RenderBody()

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>